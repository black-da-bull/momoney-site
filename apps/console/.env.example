# Server-side only — never exposed to the client bundle.
OPENAI_API_KEY=

# Model override (optional)
OPENAI_MODEL=gpt-5-mini
# Backward-compatible alias used by existing runtime code paths.
MAESTRO_MODEL=gpt-5-mini

# Dev auth fallback until the Entra ID app registration exists.
CONSOLE_USER=mo
CONSOLE_PASSWORD=

# Production/preview persistence. Attach Prisma Postgres to the Vercel `console` project.
DATABASE_URL=
# Optional aliases supplied by the Vercel integration:
# POSTGRES_URL=
# PRISMA_DATABASE_URL=

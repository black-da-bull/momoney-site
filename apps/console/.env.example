# Server-side only — never expose these variables to the client bundle.
# Values are environment-scoped in Vercel; never commit credentials.

# Preview/development AI provider credential.
# Replace with a distinct credential before Staging, then again for Production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Backward-compatible model alias used by existing runtime code paths.
MAESTRO_MODEL=gpt-5-mini

# Preview/development vector-memory credentials.
# Replace every value before Staging; do not reuse Preview indexes or namespaces.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=maestro-dev

# Dev auth fallback until the Entra ID app registration exists.
CONSOLE_USER=mo
CONSOLE_PASSWORD=

# Prisma Postgres persistence for the Vercel `console` project.
DATABASE_URL=
# Optional aliases supplied by the Vercel integration:
# POSTGRES_URL=
# PRISMA_DATABASE_URL=

# Credential policy:
# - Preview: disposable development credentials and isolated data/indexes.
# - Staging: new credentials, new Pinecone namespace/index, staging database scope.
# - Production: separately issued least-privilege credentials; never copied from Preview.

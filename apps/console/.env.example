# Server-side only — never exposed to the client bundle.
ANTHROPIC_API_KEY=

# Model overrides (optional)
MAESTRO_MODEL=claude-sonnet-5
MAESTRO_EXTRACT_MODEL=claude-haiku-4-5-20251001

# Dev auth fallback until the Entra ID app registration exists (infra-spec §4).
# Leave CONSOLE_PASSWORD empty to run open on localhost.
CONSOLE_USER=mo
CONSOLE_PASSWORD=

# Storage: file store under .data/ by default. DATABASE_URL activates Postgres (deferred).
# DATABASE_URL=

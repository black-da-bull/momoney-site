{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "POSTGRES_URL",
    "PRISMA_DATABASE_URL",
    "storage_DATABASE_URL",
    "storage_POSTGRES_URL",
    "storage_PRISMA_DATABASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENAI_EXTRACT_MODEL",
    "MAESTRO_MODEL",
    "PINECONE_API_KEY",
    "PINECONE_INDEX_HOST",
    "PINECONE_INDEX_NAME",
    "PINECONE_NAMESPACE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
